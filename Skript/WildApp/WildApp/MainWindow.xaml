<Window x:Class="WildApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WildApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Label x:Name="Temperatur" Content="Temperatur"
               HorizontalAlignment="Left" Margin="114,194,0,0" VerticalAlignment="Top"/>
        <Button Content="Temperatur holen" HorizontalAlignment="Left" Margin="10,197,0,0" VerticalAlignment="Top" Click="Button_Click"/>
        
        <Label x:Name="Wind" Content="Wind"
                HorizontalAlignment="Left" Margin="119,225,0,0" VerticalAlignment="Top"/>
        <Button Content="Wind holen" HorizontalAlignment="Left" Margin="26,228,0,0" VerticalAlignment="Top" Click="Button_Click_1"/>
        <TextBox x:Name="Stadt" HorizontalAlignment="Left" Margin="46,124,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120" TextChanged="TextBox_TextChanged"/>
        <Button Content="Daten Updaten" HorizontalAlignment="Left" Margin="275,194,0,0" VerticalAlignment="Top" Click="Button_Click_2"/>
        


    </Grid>
</Window>
