<Window x:Class="WildApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WildApp" Height="650" Width="1000" MinHeight="600" MinWidth="900">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="WildApp" FontSize="30" FontWeight="Bold"/>
            <TextBlock Text="Outdoor-Hilfe mit Wetter, WaterTest, AirTest und Tutorial-Datenbank" Foreground="Gray" FontSize="14"/>
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Wetter">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Stadt" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBox x:Name="Stadt" Height="32" Text="Dornbirn" Margin="0,0,0,10"/>
                        <Button Content="Wetterdaten holen" Height="36" Click="Button_UpdateWeather_Click"/>
                        <TextBlock Text="Unterstützte Städte: Dornbirn, Wien, Graz, Linz, Salzburg, Innsbruck, Bregenz, Feldkirch ..." TextWrapping="Wrap" Foreground="Gray" Margin="0,14,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Padding="20" Margin="24,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Aktuelle Werte" FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>
                            <TextBlock Text="Temperatur" FontWeight="Bold"/>
                            <TextBlock x:Name="Temperatur" Text="-" FontSize="24" Margin="0,0,0,18"/>
                            <TextBlock Text="Wind" FontWeight="Bold"/>
                            <TextBlock x:Name="Wind" Text="-" FontSize="24"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Tests">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,10,12">
                        <StackPanel>
                            <TextBlock Text="WaterTest" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="Simulierter Wassertest. Die Werte werden lokal erzeugt und in der Datenbank gespeichert." TextWrapping="Wrap" Foreground="Gray" Margin="0,4,0,14"/>
                            <Button Content="WaterTest ausführen" Height="34" Click="Button_WaterTest_Click" Margin="0,0,0,14"/>
                            <TextBlock x:Name="WasserQualitaet" Text="Qualität: -"/>
                            <TextBlock x:Name="WasserTemperatur" Text="Temperatur: -"/>
                            <TextBlock x:Name="Leitfaehigkeit" Text="Leitfähigkeit: -"/>
                            <TextBlock x:Name="Sauerstoff" Text="Sauerstoff: -"/>
                            <TextBlock x:Name="PhWert" Text="pH-Wert: -"/>
                            <TextBlock x:Name="WasserStatus" Text="Status: -" FontWeight="Bold" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Padding="18" Margin="10,0,0,12">
                        <StackPanel>
                            <TextBlock Text="AirTest" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="Simulierter Lufttest mit CO2, Feinstaub, Luftfeuchte und Qualitätsstatus." TextWrapping="Wrap" Foreground="Gray" Margin="0,4,0,14"/>
                            <Button Content="AirTest ausführen" Height="34" Click="Button_AirTest_Click" Margin="0,0,0,14"/>
                            <TextBlock x:Name="LuftQualitaet" Text="Qualität: -"/>
                            <TextBlock x:Name="LuftDichte" Text="Luftdichte: -"/>
                            <TextBlock x:Name="Co2" Text="CO2: -"/>
                            <TextBlock x:Name="Feinstaub" Text="Feinstaub: -"/>
                            <TextBlock x:Name="Luftfeuchtigkeit" Text="Luftfeuchtigkeit: -"/>
                            <TextBlock x:Name="LuftStatus" Text="Status: -" FontWeight="Bold" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Padding="12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Test-Verlauf" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                            <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Zeit" Binding="{Binding CreatedAt}" Width="170"/>
                                    <DataGridTextColumn Header="Typ" Binding="{Binding TestType}" Width="100"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                    <DataGridTextColumn Header="Zusammenfassung" Binding="{Binding Summary}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Tutorials">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,16,10">
                        <TextBlock Text="Kategorie" FontWeight="Bold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CategoryBox" Height="32" SelectionChanged="CategoryBox_SelectionChanged"/>
                    </StackPanel>

                    <ListBox x:Name="TutorialList" Grid.Column="0" Grid.Row="1" Margin="0,0,16,0" SelectionChanged="TutorialList_SelectionChanged" DisplayMemberPath="Title"/>

                    <Border Grid.Column="1" Grid.RowSpan="2" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel>
                            <TextBlock x:Name="TutorialTitle" Text="Tutorial auswählen" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TutorialCategory" Text="" Foreground="Gray" Margin="0,4,0,14"/>
                            <TextBlock x:Name="TutorialDescription" Text="Links ein Thema auswählen, dann werden Beschreibung, Schritte und Video-Link angezeigt." TextWrapping="Wrap" Margin="0,0,0,16"/>
                            <TextBlock Text="Schritte" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBox x:Name="TutorialSteps" Text="" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="210" VerticalScrollBarVisibility="Auto"/>
                            <Button Content="Video / Tutorial öffnen" Height="38" Width="190" HorizontalAlignment="Left" Margin="0,16,0,0" Click="Button_OpenVideo_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="DatabaseInfo" Grid.Row="2" Foreground="Gray" Margin="0,10,0,0"/>
    </Grid>
</Window>
